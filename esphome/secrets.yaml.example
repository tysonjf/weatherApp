# Copy to secrets.yaml (gitignored) and fill in.

wifi_ssid: "YourWifiName"
wifi_password: "your-wifi-password"

# Your deployed web/ app's ingest endpoint and the token you set with
# `wrangler secret put INKBIRD_UPLOAD_TOKEN` (web/README.md step 3).
upload_url: "https://inkbird-web.YOU.workers.dev/api/ingest"
upload_token: "same-token-as-the-cloudflare-secret"

# For over-the-air reflashing after the first USB flash. Pick anything long.
ota_password: "pick-a-long-random-string"

# Wi-Fi hotspot the board opens if it can't join your Wi-Fi (for rescue).
fallback_ap_password: "pick-another-password"
